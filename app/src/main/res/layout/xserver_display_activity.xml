<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/FLXServerDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/TVDependencyInstallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC202020"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/LLQuickSessionControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/LLQuickSessionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/BTQuickFullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/toggle_fullscreen"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_fullscreen"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickInputMode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/direct_touch_mode"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_mouse_mode"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickGameText"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/game_text"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_text"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickTranslate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/game_text_translate_toggle"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_translate"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickDiagnostics"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/session_diagnostics"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_task_manager"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickStrongOcr"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/game_text_strong_ocr"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_text_scan"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickAutoClicker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/auto_clicker"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_auto_clicker"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/BTQuickExit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.85"
                    android:background="@drawable/quick_session_button"
                    android:contentDescription="@string/exit"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_exit"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/BTQuickControlsToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.85"
                android:background="@drawable/quick_session_button"
                android:contentDescription="@string/collapse_quick_controls"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_more_horizontal"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:id="@+id/NavigationView"
        app:headerLayout="@layout/main_menu_header"
        app:itemIconTint="?attr/colorAccent"
        app:itemTextColor="?attr/colorPrimaryText"
        android:background="?attr/colorSecondarySurface"
        app:menu="@menu/xserver_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>